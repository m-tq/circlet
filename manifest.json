{
  "manifest_version": 3,
  "name": "circlet",
  "description": "Open public and sealed Octra Circle apps with Octra Name Service resolution, straight from the address bar.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "circlet — Octra Circle browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation"
  ],
  "omnibox": {
    "keyword": "oct"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads; default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: data:; style-src 'self' 'unsafe-inline' data: blob:; img-src data: blob:; font-src data: blob:; media-src data: blob:; connect-src 'none'; worker-src 'self' blob: data:; child-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none';"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}
